# Everything prefixed VITE_ is bundled into browser code and is PUBLIC.
# Never put secrets, API keys or tokens in this file.

# Base URL of the FelCloud control-plane API. Use a relative path ("/api") to go
# through the Vite dev proxy or a same-origin reverse proxy in production.
VITE_API_BASE_URL=/api

# Set to "true" to run against the built-in deterministic simulator. A persistent
# "DEMO DATA" banner is shown. Leave unset/false for live mode (no silent fallback).
VITE_DEMO_MODE=false

# Per-request timeout in milliseconds (default 10000).
VITE_API_TIMEOUT_MS=10000

# Label shown in the sidebar environment badge (display only).
VITE_ENVIRONMENT_LABEL=Development

# Dev-server only (not bundled): where /api is proxied to during `npm run dev`.
# Set in your shell, not here:  VITE_DEV_PROXY_TARGET=http://localhost:8000 npm run dev
