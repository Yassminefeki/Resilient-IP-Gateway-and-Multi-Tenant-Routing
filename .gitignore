# ==============================================================================
# FelCloud Resilient IP Optimizer — .gitignore
# ==============================================================================

# Credentials, Secrets & Keys
.env
.env.*
!.env.example
ansible/.vault_pass
ansible/.ssh/
*.pem
*.key
*.crt

# Runtime Databases & Local State
ipam/ipam.db
*.db
*.sqlite3

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Pulumi Local State & Stack Secrets
.pulumi/
infra/.pulumi/
*.stack.json

# Discovery Dumps, Logs & Test Outputs
*.log
scripts/*.log
output/

# Editor & OS Metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.ansible/
