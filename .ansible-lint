---
# ansible-lint project configuration
# https://ansible-lint.readthedocs.io/configuring/
profile: production

# Raise yaml line-length limit to 200 to accommodate long Jinja2 expressions
# in openssl -addext SAN fields and ansible_ssh_common_args.
warn_list:
  - yaml[line-length]

# Jinja2 expressions in openssl SAN fields and SSH args exceed 160 chars by necessity.
# Suppressing as a warning rather than a failure for those specific cases.
