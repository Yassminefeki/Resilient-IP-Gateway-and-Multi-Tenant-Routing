# ==============================================================================
# FelCloud Resilient IP Optimizer — Environment Configuration Template
# Copy this file to .env and populate real values before any deployment or test run.
# Never commit .env to version control.
# ==============================================================================

# OpenStack / FelCloud authentication
OS_AUTH_URL=https://identity.example.com/v3
OS_USERNAME=your-username
OS_PASSWORD=replace-with-your-password
OS_PROJECT_ID=00000000000000000000000000000000
OS_PROJECT_NAME=your-project
OS_TENANT_ID=00000000000000000000000000000000
OS_TENANT_NAME=your-project
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default
OS_REGION_NAME=North-Africa
OS_INTERFACE=public

# HAProxy Data Plane API (credentials are stored in Ansible Vault; set here for scripts only)
HAPROXY_DPA_URL_GW1=https://gw1.example.internal:5555
HAPROXY_DPA_URL_GW2=https://gw2.example.internal:5555
HAPROXY_DPA_USERNAME=admin
HAPROXY_DPA_PASSWORD=replace-with-secure-password
HAPROXY_DPA_TIMEOUT_SECONDS=10

# Bastion / jump host access
BASTION_IP=203.0.113.10
# Path to SSH private key written by generate_inventory.py
# ANSIBLE_SSH_KEY is NOT used by Ansible directly; key_path is written by generate_inventory.py
ANSIBLE_SSH_KEY=ansible/.ssh/id_rsa_felcloud

# Sandbox provisioning defaults
OPENSTACK_IMAGE_NAME="Ubuntu 24.04 LTS - Noble Numbat"
OPENSTACK_FLAVOR_NAME="G0.basic.2c2g"
OPENSTACK_KEYPAIR_NAME=felcloud-resilient-v2
OPENSTACK_AVAILABILITY_ZONE=TN-Carthage
OPENSTACK_NETWORK_NAME=felcloud-sandbox
OPENSTACK_SECURITY_GROUP_NAME=sg-sandbox
TEAM_NAME=team-demo

# Control-plane timing and lease policy
ROUTING_DOMAIN=sandbox.example.com # Base domain for team sandbox routing and Host headers (default: sandbox.example.com)
IP_QUARANTINE_SECONDS=300
HEALTH_CHECK_TIMEOUT_SECONDS=30

# Go control-plane API security
# Set a random secret of at least 24 characters before starting the API.
ADMIN_TOKEN=
# Leave unset/false in production. true explicitly disables bearer authentication.
AUTH_DISABLED=false
# Maximum mutating requests per client IP per minute (default: 30).
RATE_LIMIT_PER_MIN=30
# Optional single browser origin; unset disables CORS.
# CORS_ORIGIN=https://console.example.com

# Discovery and test defaults
# output/ is the default discovery dump directory (docs/ has been removed)
DISCOVERY_OUTPUT_DIR=output
GW1_HOST=gw1
GW2_HOST=gw2
TARGET_URL=http://203.0.113.119
RECYCLE_BASE_URL=http://localhost:8080
RECYCLE_COOLDOWN_SECONDS=300
ANSIBLE_INVENTORY=ansible/inventory/hosts.yml
CONTROL_PLANE_BASE_URL=http://localhost:8080
GATEWAY_API_BASE_URL=http://localhost:8081
# Failover API and script poll this URL from the control-plane host. Point it at a routed
# HTTP service hostname that answers below 400 and returns X-Gateway-ID.
FAILOVER_PROBE_URL=http://team1.sandbox.example.com/
# Optional Host header override when FAILOVER_PROBE_URL targets a VIP address.
# FAILOVER_PROBE_HOST=team1.sandbox.example.com
FAILOVER_THRESHOLD_MS=3000
# The host running controlplane must be able to reach FAILOVER_PROBE_URL/VIP.

# HAProxy transactional deployment and automatic rollback health window
HEALTH_REGRESSION_WINDOW_SECONDS=45
# Optional override for the transactional deployment playbook.
HAPROXY_TRANSACTION_PLAYBOOK=../ansible/haproxy-transaction.yml

# Go API Nova + Neutron sandbox provisioner (required unless PROVISIONER=mock)
# Use either SANDBOX_NETWORK_ID or SANDBOX_NETWORK_NAME.
SANDBOX_NETWORK_ID=
SANDBOX_NETWORK_NAME=felcloud-sandbox
SANDBOX_SUBNET_ID=
SANDBOX_SG_NAME=sg-sandbox
SANDBOX_IMAGE=
SANDBOX_FLAVOR=
SANDBOX_KEYPAIR=felcloud-resilient-v2
PROVISION_TIMEOUT_SECONDS=180
HEALTH_PROBE_TIMEOUT_SECONDS=90
HEALTH_PROBE_MODE=gateway-ssh
# Require both gateways to report healthy (all) or at least one (any).
HEALTH_PROBE_REQUIRE=all
# gateway-ssh reads both gateway addresses and the private key from ANSIBLE_INVENTORY.
# HEALTH_PROBE_SSH_JUMP=ansible@203.0.113.10
# HEALTH_PROBE_SSH_KEY=../ansible/.ssh/id_rsa_felcloud
# SSH host keys are accepted on first connect and stored at this path.
FELCLOUD_KNOWN_HOSTS=../ansible/.ssh/known_hosts
MAX_CONCURRENT_PROVISIONS=8
TEARDOWN_TIMEOUT_SECONDS=120
TEARDOWN_CONCURRENCY=4
# Local development only; never enabled implicitly.
# PROVISIONER=mock
# Optional mock-only fault injection for local regression tests.
# MOCK_FAIL_STEP=create
# MOCK_FAIL_TEAM_PREFIX=demo-
# MOCK_PROVISION_DELAY_MS=100
