# ==============================================================================
# FelCloud Resilient IP Optimizer — Environment Configuration Template
# Copy this file to .env and populate real values before any deployment or test run.
# Never commit .env to version control.
# ==============================================================================

# OpenStack / FelCloud authentication
OS_AUTH_URL=https://identity.example.com/v3
OS_USERNAME=your-username
OS_PASSWORD=replace-with-your-password
OS_PROJECT_ID=00000000000000000000000000000000
OS_PROJECT_NAME=your-project
OS_TENANT_ID=00000000000000000000000000000000
OS_TENANT_NAME=your-project
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default
OS_REGION_NAME=North-Africa
OS_INTERFACE=public

# HAProxy Data Plane API (credentials are stored in Ansible Vault; set here for scripts only)
HAPROXY_DPA_URL_GW1=https://gw1.example.internal:5555
HAPROXY_DPA_URL_GW2=https://gw2.example.internal:5555
HAPROXY_DPA_USERNAME=admin
HAPROXY_DPA_PASSWORD=replace-with-secure-password
HAPROXY_DPA_TIMEOUT_SECONDS=10

# Bastion / jump host access
BASTION_IP=203.0.113.119
# Path to SSH private key written by generate_inventory.py
# ANSIBLE_SSH_KEY is NOT used by Ansible directly; key_path is written by generate_inventory.py
ANSIBLE_SSH_KEY=ansible/.ssh/id_rsa_felcloud

# Sandbox provisioning defaults
OPENSTACK_IMAGE_NAME="Ubuntu 24.04 LTS - Noble Numbat"
OPENSTACK_FLAVOR_NAME="G0.basic.2c2g"
OPENSTACK_KEYPAIR_NAME=felcloud-resilient-v2
OPENSTACK_AVAILABILITY_ZONE=TN-Carthage
OPENSTACK_NETWORK_NAME=felcloud-sandbox
OPENSTACK_SECURITY_GROUP_NAME=sg-sandbox
TEAM_NAME=team-demo

# Control-plane timing and lease policy
IP_QUARANTINE_SECONDS=300
PROVISION_TIMEOUT_SECONDS=600
HEALTH_CHECK_TIMEOUT_SECONDS=30

# Discovery and test defaults
# output/ is the default discovery dump directory (docs/ has been removed)
DISCOVERY_OUTPUT_DIR=output
GW1_HOST=gw1
GW2_HOST=gw2
TARGET_URL=http://203.0.113.119
RECYCLE_BASE_URL=http://localhost:8080
RECYCLE_COOLDOWN_SECONDS=300
ANSIBLE_INVENTORY=ansible/inventory/hosts.yml
CONTROL_PLANE_BASE_URL=http://localhost:8080
