    "prober": "#cloud-config\nwrite_files:\n  - path: /etc/systemd/system/t7-prober-http.service\n    content: |\n      [Unit]\n      Description=T7 result HTTP transport\n      After=network-online.target\n      Wants=network-online.target\n      [Service]\n      ExecStart=/usr/bin/python3 -m http.server 80 --directory /var/www/t7\n      Restart=always\n      [Install]\n      WantedBy=multi-user.target\n  - path: /usr/local/bin/t7-probe.sh\n    permissions: '0755'\n    content: |\n      #!/usr/bin/env bash\n      set +e\n      started=$SECONDS\n      mkdir -p \"$(dirname /var/www/t7/result.json)\"\n      results=\"\"\n      separator=\"\"\n      while IFS='|' read -r target address port classification; do\n        if [ -z \"$target\" ]; then continue; fi\n        if [ \"$((SECONDS-started))\" -ge 110 ]; then\n          result=\"timeout\"\n        else\n          timeout 3 bash -c 'exec 3<>/dev/tcp/$1/$2' _ \"$address\" \"$port\" >/dev/null 2>&1\n          rc=$?\n          if [ \"$rc\" -eq 0 ]; then result=\"open\"\n          elif [ \"$rc\" -eq 124 ]; then result=\"timeout\"\n          else result=\"refused\"\n          fi\n        fi\n        printf -v item '{\"target\":\"%s\",\"ip\":\"%s\",\"port\":%s,\"result\":\"%s\",\"classification\":\"%s\"}' \\\n          \"$target\" \"$address\" \"$port\" \"$result\" \"$classification\"\n        results=\"${results}${separator}${item}\"\n        separator=\",\" \n      done <<'T7_PROBES'\n      gw1|10.20.30.86|22|forbidden\n      gw1|10.20.30.86|80|allowed\n      gw1|10.20.30.86|443|allowed\n      gw1|10.20.30.86|5555|forbidden\n      gw2|10.20.30.224|22|forbidden\n      gw2|10.20.30.224|80|allowed\n      gw2|10.20.30.224|443|allowed\n      gw2|10.20.30.224|5555|forbidden\n      sandbox_b|10.20.30.98|22|forbidden\n      sandbox_b|10.20.30.98|80|forbidden\n      sandbox_b|10.20.30.98|8080|forbidden\n      team1|10.20.30.37|22|forbidden\n      team1|10.20.30.37|80|forbidden\n      team1|10.20.30.37|8080|forbidden\n      team2|10.20.30.15|22|forbidden\n      team2|10.20.30.15|80|forbidden\n      team2|10.20.30.15|8080|forbidden\n      bastion_edge|10.20.20.177|22|forbidden\n      bastion_mgmt|10.20.10.246|22|forbidden\n      metadata|169.254.169.254|80|record_only\n      gw1_mgmt|10.20.10.24|22|forbidden\n      gw1_mgmt|10.20.10.24|5555|forbidden\n      gw2_mgmt|10.20.10.164|22|forbidden\n      gw2_mgmt|10.20.10.164|5555|forbidden\n      T7_PROBES\n      printf -v json '{\"results\":[%s],\"duration_seconds\":%s}' \"$results\" \"$((SECONDS-started))\"\n      result_tmp=\"/var/www/t7/result.json.tmp.$$\"\n      printf '%s\\n' \"$json\" > \"$result_tmp\" && mv -f \"$result_tmp\" \"/var/www/t7/result.json\"\nruncmd:\n  - [mkdir, -p, /var/www/t7]\n  - [systemctl, daemon-reload]\n  - [systemctl, enable, --now, t7-prober-http.service]\n  - [bash, /usr/local/bin/t7-probe.sh]\n",
